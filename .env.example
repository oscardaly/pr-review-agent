# --- Model provider (choose one path) ---

# OpenAI directly:
OPENAI_API_KEY=

# ...or any OpenAI-compatible endpoint, e.g. Vercel AI Gateway:
# OPENAI_API_KEY=<your gateway key>
# OPENAI_BASE_URL=https://ai-gateway.vercel.sh/v1
# PR_AGENT_MODEL=anthropic/claude-sonnet-4.5

# ...or Anthropic directly:
# ANTHROPIC_API_KEY=
# PR_AGENT_MODEL=claude-sonnet-4-5

# Default model when unset: gpt-4o-mini
# PR_AGENT_MODEL=gpt-4o-mini

# --- LangSmith tracing & evals ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# Project *name* (not a UUID) — auto-created on the first traced run.
LANGSMITH_PROJECT=pr-review-agent
# EU-region accounts must set this: the SDK defaults to the US endpoint,
# and mismatched regions fail every trace upload with 403 Forbidden.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Ticket context (optional) ---
# With a Linear API key (or OAuth token), Leo fetches the ticket a PR
# references (e.g. FLU-123 in the title) via Linear's MCP server and reviews
# the diff against its stated intent.
# LINEAR_API_KEY=

# --- Agent settings (defaults shown) ---
# PR_AGENT_USER_DOCS_PATH=./fixtures/user-docs   # point at your real user docs
# PR_AGENT_KNOWLEDGE_PATH=./knowledge
# PR_AGENT_OUTPUT_PATH=./review-output
# PR_AGENT_VALIDATION_THRESHOLD=0.6
